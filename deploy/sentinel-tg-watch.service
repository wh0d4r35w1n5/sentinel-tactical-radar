[Unit]
Description=Sentinel VIP telegram confluence watcher
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/sentinel
ExecStart=/usr/bin/python3 -u scripts/tg-watch.py
Restart=always
RestartSec=15
StandardOutput=append:/var/log/sentinel-tg.log
StandardError=append:/var/log/sentinel-tg.log

[Install]
WantedBy=multi-user.target
