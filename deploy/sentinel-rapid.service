[Unit]
Description=Sentinel rapid daemon (15s scan+exec loop)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/sentinel
ExecStart=/usr/bin/node scripts/rapid.mjs
Environment=RAPID_MS=15000
Environment=SENTINEL_NO_TG=1
Environment=RAPID_MODE=live
Environment=SENTINEL_RISK_PROFILE=max
Restart=always
RestartSec=10
StandardOutput=append:/var/log/sentinel-rapid.log
StandardError=append:/var/log/sentinel-rapid.log

[Install]
WantedBy=multi-user.target
