# Bitget API credentials for scripts/bitget-exec.mjs — copy to .env (never committed).
# CREATE THE KEY AS TRADE-ONLY: Bitget → API Management → permissions = "Trade"
# only, withdrawals DISABLED. If your IP is static, bind the whitelist too.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# DEMO credentials — Bitget requires a SEPARATE key created inside demo mode:
# Bitget → Futures → Demo trading → API Management → create key (same perms).
# If unset, demo falls back to the main keys (which will 40099 — get demo keys).
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_PASSPHRASE=

# Execution mode: shadow (plan only, no keys) | demo (Bitget paper funds) | live
SENTINEL_EXEC=shadow

# LIVE MODE requires BOTH of these, deliberately awkward on purpose:
SENTINEL_LIVE=
CONFIRM_LIVE=

# Live risk rails
LIVE_MAX_NOTIONAL_USD=50
LIVE_MAX_POSITIONS=3
# Dust-account mode: floor under-sized orders UP to the contract minimum
# (~5 USDT notional) instead of skipping — for proving live flow on tiny
# balances. 1 = enabled. At $3 equity a -1.5% stop costs ~2.5% of the
# account — the 1%-risk model cannot hold at this size.
LIVE_FLOOR_MIN=

# Risk profile: 'max' = maximum aggression — entry floor 55, DD kill 35%,
# daily halt 25%, widened heat caps, no vol haircut. Unset/anything else =
# default profile (floor 70, DD kill 8%, daily halt 6%).
SENTINEL_RISK_PROFILE=max
# Optional explicit overrides (take precedence over the profile):
SENTINEL_DD_KILL_PCT=
SENTINEL_DAILY_HALT_PCT=
SENTINEL_MIN_SCORE=

# Single-position margin cap — fraction of equity one entry may post.
# 0.85 = near-full aggression on a qualifying shot, one reload left.
SENTINEL_POS_CAP_PCT=0.85
# Minimum account equity for any new entry (capital preservation floor)
SENTINEL_MIN_EQUITY=
# Rolling 1h entry cap (name is legacy — it's per-hour, not per-day)
EXEC_MAX_ENTRIES_DAY=3
# Comma-separated symbols exempt from ALL auto-management (rebalance,
# decay, thesis-flip, scalp ladder). Protection repair still runs —
# a held position is never naked. Use for manually opened positions.
SENTINEL_MANUAL_HOLD=
# Target/max open positions for the rebalancer
LIVE_TARGET_POSITIONS=
# Rapid loop cadence (ms, min 5000) — VPS runs 15000
RAPID_MS=15000
# Set to 1 to disable the VIP telegram watcher under rapid.mjs
SENTINEL_NO_TG=
