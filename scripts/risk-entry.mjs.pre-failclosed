import fs from 'node:fs';
import path from 'node:path';
import { ROOT, EXIT_MODEL, canonicalCell, hourlyTrail, readJson } from './execution-risk.mjs';

// Rolling 5-minute VWAP — Bitget USDT-M futures candles, last 96 bars
// (~8h). Used for stop invalidation (operator order 2026-11-13), NOT the
// side gate — that stays on the session VWAP. 60s cache; fail-open null.
const vwap5mCache = new Map();
async function vwap5m(sym) {
  const hit = vwap5mCache.get(sym);
  if (hit && Date.now() - hit.at < 60000) return hit.v;
  let v = null;
  try {
    const r = await fetch(`https://api.bitget.com/api/v2/mix/market/candles?symbol=${sym}&productType=USDT-FUTURES&granularity=5m&limit=96`, { signal: AbortSignal.timeout(8000) });
    const j = await r.json();
    const rows = Array.isArray(j?.data) ? j.data : null;
    if (rows && rows.length >= 8) {
      let pv = 0, vv = 0;
      for (const c of rows) {
        const q = +c[6] || 0;
        if (q > 0) { pv += ((+c[2] + +c[3] + +c[4]) / 3) * q; vv += q; }
      }
      if (vv > 0) v = pv / vv;
    }
  } catch {}
  vwap5mCache.set(sym, { v, at: Date.now() });
  return v;
}

const seatsFile = (root) => path.join(root, 'state', 'execution-seats.json');
const writeSeats = (root, seats) => {
  const file = seatsFile(root), tmp = `${file}.${process.pid}.tmp`;
  fs.writeFileSync(tmp, JSON.stringify(seats)); fs.renameSync(tmp, file);
};
export function executionSeat(position, root = ROOT) {
  try {
    const symbol = position.symbol || position.sym,
      side = String(position.holdSide || position.side || '').toLowerCase();
    const seat = readJson(seatsFile(root), true)?.[`${symbol}:${side}`];
    return seat?.exitModel === EXIT_MODEL && +seat.cTime === +position.cTime ? seat : null;
  } catch { return null; } // unreadable seats file must not kill a protection pass
}

export async function openRiskEntry(X, order, contract, { riskScale = 1, root = ROOT,
  sleep = ms => new Promise(r => setTimeout(r, ms)) } = {}) {
  const cell = canonicalCell(order.strategy, order.direction);
  const pocket = cell && `${cell}:${order.symbol}`;
  // Convicted cells take NO orders in ANY mode (operator doctrine + open-
  // season scope: "halted/abandoned policy" still refuses). Canon live orders
  // skip the exec's policy veto because cell-admission owns their evidence —
  // but admission's mega-backtest pockets never saw the forward-tested
  // abandoned verdicts, so PIUSDT seated on Key Level SFP:LONG 2026-11-10
  // while the cell read abandoned (n=151, CI[-2.88,-1.20]). Same lookup order
  // as the exec veto: per-direction cell record, then strategy-level.
  let sp = null;
  try {
    const spDoc = readJson(path.join(root, 'state', 'strategy-policy.json'), true);
    sp = (order.strategy && spDoc?.cells?.[`${order.strategy}:${order.direction}`])
      || (order.strategy && spDoc?.strategies?.[order.strategy]) || null;
  } catch {}
  if (sp && (sp.status === 'halted' || sp.status === 'abandoned'))
    throw new Error(`entry-risk: ${order.strategy}:${order.direction} policy-${sp.status} — ${(sp.why || '').slice(0, 100)}`);
  // REALIZED-R CONVICTION (2026-11-12): autoimprove section 10 scores every
  // cell on its own round-trip R-stream (net/riskUsd) and convicts at n>=25
  // with SQN <= -1.7. All 260 journal seats had entered at 'probation' via
  // open-season/mandate lanes and three cells (SFP:LONG, core-carry:LONG,
  // sqn-factory:SHORT) were significantly negative on real money with no
  // rail judging them. Convictions refuse in every lane — same scope as the
  // policy veto above. Fails OPEN on a missing/stale (>30min) record so a
  // dead autoimprove can never park the book. bleed-exempt.json pairs
  // (operator-designated symbols) pass.
  // P3: fills-sync freshness gate — entries only, exits unaffected.
  // Heartbeat written by exec P3a (lastFillSyncOk); absent/stale = blind.
  try {
    const lfs = readJson(path.join(root, "api", "live-ledger.json"), true)?.lastFillSyncOk;
    if (!lfs || Date.now() - (+lfs || 0) > 15 * 60_000)
      throw new Error("entry-risk: attribution-blind - fills-sync stale/missing, entries refused");
  } catch (e) { if (/attribution-blind/.test(e?.message || "")) throw e; }
  try {
    const cr = readJson(path.join(root, "state", "cell-realized.json"), true);
    const row = cell && cr?.cells?.[cell];
    const crFresh = Date.now() - (+cr?.at || 0) < 30 * 60_000;
    const ex = readJson(path.join(root, "state", "bleed-exempt.json"), true)?.pairs || [];
    const exempted = ex.includes(`${order.symbol}:${order.direction}`);
    if (row?.convicted === true && crFresh && !exempted)
      throw new Error(`entry-risk: ${cell} realized-convicted — SQN ${row.sqn} avgR ${row.avgR} over n=${row.n} real seats`);
    // P1/P2: rolling-15 negative-R veto — lane-agnostic, NEW_SYSTEM_EXTRA
    // included; replay W15/N20 = -13.44R counterfactual vs -47.18R baseline.
    if (row && !exempted && crFresh && (row.n ?? 0) >= 20 &&
        Number.isFinite(+row.roll15SumR) && +row.roll15SumR < 0)
      throw new Error(`entry-risk: ${cell} rolling-negative — last15 sumR ${row.roll15SumR} over n=${row.n} real seats`);
  } catch (e) { if (/realized-convicted|rolling-negative|attribution-blind/.test(e?.message || "")) throw e; }
  const allow = readJson(path.join(root, 'state', 'live-cell-allowlist.json'), true);
  const adm = readJson(path.join(root, 'state', 'cell-admission.json'), true);
  // OPEN SEASON (operator order 2026-11-04): unrecorded/unconvicted cells
  // admit at probation — convictions (dead, non-positive mean) still refuse.
  const openSeason = process.env.SENTINEL_OPEN_SEASON != null
    ? process.env.SENTINEL_OPEN_SEASON === '1'
    : readJson(path.join(root, 'state', 'open-season.json'), true)?.enabled === true;
  const listed = openSeason || (allow?.enabled === true &&
    (allow?.cells?.includes(cell) || (pocket && allow?.cells?.includes(pocket))));
  const ev = (pocket && adm?.cells?.[pocket]) || adm?.cells?.[cell];
  let tier =
    ev?.status === 'live' && ev.source === 'validated-forward-exits' &&
    ev.episodes >= 3 ? 'live'
    : ev?.status === 'probation' && ev.source === 'mega-backtest-1m' &&
      ev.episodes >= 200 ? 'probation'
    : null;
  if (!tier && openSeason && ev?.status !== 'dead' && !(ev && !(ev.netAfterCost > 0)))
    tier = 'probation';
  if (!listed || !tier || (ev && !(ev.netAfterCost > 0)) ||
      (!openSeason && (
        (tier === 'live' && !(ev.ci?.[0] > 0)) ||
        (tier === 'probation' && !(ev.sqn >= 1 || ev.ci?.[0] > 0)))))
    throw new Error(`entry-risk: ${cell || order.strategy || 'unattributed'} has no qualifying evidence`);
  if (tier === 'probation') riskScale *= 0.5; // backtest-only proof earns half risk
  const price = +order.refEntry;
  if (!(price > 0) || !(+contract.pricePlace >= 0) || !(+contract.sizePlace >= 0))
    throw new Error('entry-risk: missing entry price or contract geometry');
  const tick = +contract.priceTick || 10 ** -(+contract.pricePlace || 0);
  // Parity with the tested model (full-backtest simTrade): stopPx =
  // structStopPx ?? entry*(1-1%). The structural invalidation (wyckoff.invalid,
  // the spring low) is the base stop; the K2 trail only ever tightens it —
  // peak−2·ATR14 appears by itself at the first protectRiskSeat pass with
  // peak=entry. A malformed/missing invalidation falls to the flat 1% grid,
  // exactly like the backtest.
  // Setup orders carry their own absolute stop (slPx/absSl) — it IS the
  // strategy's invalidation and the notional was sized against it. The rail
  // ignored it and placed its own ~1% grid stop, cutting real risk to ~1/3
  // of intended (Claude 19:00Z: MEGA authored -3.09%, rail stopped -1%).
  // Setup slPx wins; non-setup orders keep the wyckoff/structural chain.
  const structural = +(order.setup && (order.slPx > 0 || order.absSl > 0)
    ? (order.slPx || order.absSl)
    : (order.wyckInvalid ?? order.structInvalid));
  const shortDir = order.direction === 'SHORT';
  let rawStop = structural > 0
    ? (shortDir ? (structural > price ? structural : price * 1.01)
                : (structural < price ? structural : price * 0.99))
    : price * (shortDir ? 1.01 : 0.99);
  // 5m-VWAP invalidation (operator order 2026-11-13): with no structural
  // level, the stop anchors just beyond the 5-minute VWAP — a LONG dies
  // when price loses acceptance back under it, a SHORT dies reclaiming it.
  // 0.3% buffer, clamped to [0.4%,6%] of entry; unreadable feed keeps the
  // flat 1% grid (same fail-open semantics as the VWAP side gate).
  if (!(structural > 0)) {
    const w5 = await vwap5m(order.symbol);
    if (w5 > 0) {
      const cand = shortDir ? w5 * 1.003 : w5 * 0.997;
      const df = Math.abs(price - cand) / price;
      if (df >= 0.004 && df <= 0.06 && (shortDir ? cand > price : cand < price))
        rawStop = cand;
    }
  }
  const stopPrice = +(Math.floor(rawStop / tick) * tick).toFixed(+contract.pricePlace || 0);
  const intent = { symbol: order.symbol, strategy: order.strategy, direction: order.direction,
    exitModel: EXIT_MODEL, entryPrice: price, stopPrice, riskScale, confirmPrint: order.confirmPrint,
    // setup orders carry notionalUsd sized from THEIR riskPct — pass it as
    // the rail's cap so a 2% facx probe can't be inflated to the 30% policy
    // budget (Claude audit 2026-11-12: probes were risking 7.5x intended).
    // min() semantics: it can only shrink the seat, never grow it.
    requestedNotionalUsd: order.setup ? order.notionalUsd : order.riskCapNotionalUsd };
  let entryIntent = intent;
  let approved;
  try {
    approved = await X.prepareEntry(entryIntent);
  } catch (e) {
    // contract-min floor (operator LIVE_FLOOR_MIN doctrine at the risk rail,
    // 2026-11-12): the dd-scaled risk budget can size a seat under one
    // exchange lot and the book then refuses trades it can plainly afford.
    // Retry once with risk scale lifted and notional pinned just above the
    // contract minimum — bounded; every other cap unchanged.
    if (!/contract minimum exceeds/.test(e?.message || '')) throw e;
    const px = +order.refEntry;
    const cstep = +contract?.sizeMultiplier || 10 ** -(+contract?.sizePlace || 0);
    const cmin = Math.max(+contract?.minTradeNum || 0, (+contract?.minTradeUSDT || 0) / px);
    const minLots = Math.max(1, Math.ceil((cmin - cstep * 1e-9) / cstep));
    const retryIntent = { ...intent,
      riskScale: Math.max(intent.riskScale ?? 1, 0.5),
      requestedNotionalUsd: minLots * cstep * px * 1.05 };
    entryIntent = retryIntent;
    try {
      approved = await X.prepareEntry(entryIntent);
    } catch (e2) {
      try { fs.appendFileSync(path.join(root, 'state', 'entry-risk-audit.jsonl'),
        JSON.stringify({ ts: Date.now(), event: 'minfloor-retry-failed', symbol: order.symbol,
          firstErr: String(e.message).slice(0, 160), retryErr: String(e2.message).slice(0, 200),
          intent: { entryPrice: intent.entryPrice, stopPrice: intent.stopPrice,
            riskScale: intent.riskScale, reqNotional: retryIntent.requestedNotionalUsd },
          contract: { minTradeNum: contract?.minTradeNum, minTradeUSDT: contract?.minTradeUSDT,
            sizeMultiplier: contract?.sizeMultiplier, sizePlace: contract?.sizePlace } }) + String.fromCharCode(10)); } catch {}
      throw e2;
    }
  }
  // Skip no-op margin/leverage writes — Bitget can reject them and a spurious
  // refusal must not stall a valid entry.
  if (approved.marginMode !== 'isolated') await X.setIsolated(order.symbol);
  if (approved.actualLeverage !== approved.leverage)
  try { await X.setLeverage(order.symbol, approved.leverage); }
  catch (e) {
    const cap = /leverage is (\d+)x/i.exec(e.message || '');
    if (!cap || +cap[1] >= approved.leverage) throw e;
    approved = await X.prepareEntry({ ...intent, leverageCap: +cap[1],
      requestedNotionalUsd: approved.notionalUsd });
    if (approved.actualLeverage !== approved.leverage)
      await X.setLeverage(order.symbol, approved.leverage);
  }
  const assertFiveTpCapacity = (size) => {
    const cfg = readJson(path.join(root, 'state', 'rr-config.json'), true);
    const rungs = Array.isArray(cfg?.absPct) ? cfg.absPct.length : 0;
    const allocations = Array.isArray(cfg?.alloc) ? cfg.alloc.length : 0;
    if (rungs !== 5 || allocations !== 5)
      throw new Error('entry-risk: five-rung TP configuration is missing or inconsistent');
    const places = +contract.sizePlace;
    const lotStep = +contract.sizeMultiplier || 10 ** -places;
    const minimum = +contract.minTradeNum || lotStep;
    if (!Number.isFinite(lotStep) || lotStep <= 0 || !Number.isFinite(minimum) || minimum <= 0)
      throw new Error('entry-risk: invalid contract lot size for five-rung TP');
    const minSlice = Math.ceil((minimum - lotStep * 1e-9) / lotStep) * lotStep;
    // adaptive ladder (operator 2026-11-06: "more or less rungs when more
    // efficient — profits over everything"): the seat needs ONE rung, not
    // five — bitget-watch already places only slices >= minSlice, so small
    // seats naturally ladder fewer rungs instead of refusing outright.
    const required = minSlice;
    if (+size + lotStep * 1e-9 < required)
      throw new Error('entry-risk: TP ladder requires at least ' + required + ' ' + order.symbol + ' contracts; risk-sized ' + size);
  };
  try {
    assertFiveTpCapacity(approved.size);
  } catch (e) {
    // ladder-floor retry: a seat risk-sized under the five-rung contract
    // minimum is bumped to the floor when the risk pipeline allows the
    // larger notional — otherwise ETH/SOL-class contracts can never seat
    // at probe sizes. The second assert still throws if prepareEntry caps
    // it below the floor — rails hold either way.
    const m = /requires at least ([\d.eE+-]+)/.exec(e.message || '');
    if (!m || !(+m[1] * price > 0)) throw e;
    approved = await X.prepareEntry({ ...intent, requestedNotionalUsd: +m[1] * price });
    assertFiveTpCapacity(approved.size);
    if (approved.marginMode !== 'isolated') await X.setIsolated(order.symbol);
    if (approved.actualLeverage !== approved.leverage) await X.setLeverage(order.symbol, approved.leverage);
  }
  const openSide = order.direction === 'SHORT' ? 'sell' : 'buy';
  const holdSide = order.direction === 'SHORT' ? 'short' : 'long';
  try {
    await X.marketOrder(order.symbol, openSide, approved.size, 'open', {
      clientOid: approved.clientOid, presetStopLossPrice: String(stopPrice),
      // presetStopLossExecutePrice omitted — contracts 40808-reject the
      // explicit '0' (Claude defect 2); market-execute is implied anyway.
    });
  } catch (e) {
    // 40808 on exeStopLossPrice: this contract rejects the explicit '0'
    // execute price — resubmit with the field omitted (market-execute
    // implied). The permit diff only binds presetStopLossPrice, which is
    // unchanged; a consumed permit means we need a fresh prepareEntry.
    if (!/40808/.test(e.message || '')) throw e;
    approved = await X.prepareEntry({ ...entryIntent });
    assertFiveTpCapacity(approved.size);
    await X.marketOrder(order.symbol, openSide, approved.size, 'open', {
      clientOid: approved.clientOid, presetStopLossPrice: String(stopPrice),
    });
  }
  let pos;
  for (let i = 0; i < 9; i++) {
    pos = (await X.getPos()).find(p => p.symbol === order.symbol && p.holdSide === holdSide && +p.total > 0);
    if (pos) break;
    // fast early polls — the fill-vs-stop re-anchor below must beat the
    // exchange preset stop, which fires the moment price touches it (HUT
    // died 2s after fill on a stop anchored to a stale ref price)
    await sleep(i < 6 ? 250 : 1000);
  }
  if (!pos) throw new Error('entry-risk: submitted order awaits exchange position indexing; further entries blocked');
  const seats = readJson(seatsFile(root), true) || {};
  const record = { symbol: order.symbol, side: holdSide, cTime: +pos.cTime,
    strategy: order.strategy, cell: cell, exitModel: EXIT_MODEL,
    entryPrice: +pos.openPriceAvg, initialStop: stopPrice, size: +pos.total,
    clientOid: approved.clientOid, leverage: +pos.leverage, riskUsd: approved.riskUsd,
    openedAt: +pos.cTime, at: Date.now() };
  seats[`${order.symbol}:${holdSide}`] = record;
  writeSeats(root, seats);
  try {
    // Fill-vs-stop re-anchor (HUT 2026-11-12): the preset stop anchors to
    // refEntry but the real fill can slip past it — HUT filled 1.18% under
    // ref, the stop landed ABOVE the fill and killed the seat in 2s. When
    // the stop sits on the wrong side of the actual fill, cancel the stale
    // loss plans and re-place at fillPx preserving the intended stop
    // distance. effStop then drives verification + the seat record.
    const fillPx = +pos.openPriceAvg;
    const refPx = +order.refEntry || price;
    const stopDist = refPx > 0 ? Math.abs(refPx - stopPrice) / refPx : 0;
    let effStop = stopPrice;
    if (fillPx > 0 && stopDist > 0 &&
        (holdSide === 'long' ? stopPrice >= fillPx : stopPrice <= fillPx)) {
      effStop = +(holdSide === 'long' ? fillPx * (1 - stopDist) : fillPx * (1 + stopDist))
        .toFixed(+contract?.pricePlace || 8);
      const stale = (await X.getPlans(order.symbol) || [])
        .filter(p => /loss/.test(p.planType || '') && (p.orderId || p.id));
      for (const p of stale)
        await X.cancelPlanOrders(order.symbol, p.planType || 'pos_loss',
          [String(p.orderId || p.id)]).catch(() => {});
      await X.planOrder(order.symbol, 'pos_loss', String(effStop), '0', holdSide, pos.marginMode);
      record.initialStop = effStop;
      writeSeats(root, seats);
    }
    const plans = await X.getPlans(order.symbol);
    const stopOk = (p) => /loss/.test(p.planType || '') &&
        (p.planType === 'pos_loss' || +p.size >= +pos.total) &&
        (holdSide === 'short' ? +p.triggerPrice <= effStop : +p.triggerPrice >= effStop);
    if (!plans.some(stopOk))
      await X.planOrder(order.symbol, 'pos_loss', String(effStop), '0', holdSide, pos.marginMode);
    await X.completeEntry(approved.clientOid);
  } catch (e) {
    // The seat is REAL and journaled — protection verifies on the next watch
    // cycle and the pending file reconciles once covered. Do not report the
    // position as refused; it exists on the exchange.
    return { ...approved, ...record, notionalUsd: +pos.total * +pos.openPriceAvg,
      marginUsd: +pos.total * +pos.openPriceAvg / +pos.leverage,
      protectionPending: e.message };
  }
  return { ...approved, ...record, notionalUsd: +pos.total * +pos.openPriceAvg,
    marginUsd: +pos.total * +pos.openPriceAvg / +pos.leverage };
}

const candleCache = new Map();
// The protection watcher owns this exit model. Exec and liq-guard must not
// overlay fee locks, ladders, tick trails, trims or expiry exits on these seats.
export async function protectRiskSeat(X, pos, contract, { now = Date.now(), root = ROOT } = {}) {
  const seat = executionSeat(pos, root);
  if (!seat) return false;
  const symbol = pos.symbol;
  const side = String(pos.holdSide || pos.side || 'long').toLowerCase() === 'short' ? 'short' : 'long';
  const S = side === 'short';
  const plans = await X.getPlans(symbol);
  const existing = plans.filter(p => /loss/.test(p.planType || '') &&
    (!p.holdSide || p.holdSide === side));
  const trig = existing.map(p => +p.triggerPrice).filter(x => x > 0);
  const priorStop = S ? Math.min(seat.initialStop, ...trig) : Math.max(seat.initialStop, ...trig);
  if (now - seat.openedAt >= 96 * 3600000) {
    await X.closePosition(symbol, side);
    return true;
  }
  let cached = candleCache.get(symbol);
  const hour = Math.floor(now / 3600000);
  if (!cached || cached.hour !== hour) {
    const rows = await X.api('GET', '/api/v2/mix/market/history-candles', {
      qs: new URLSearchParams({ symbol, productType: 'USDT-FUTURES', granularity: '1H',
        endTime: String(hour * 3600000 - 1), limit: '200' }).toString(),
    });
    if (!Array.isArray(rows)) throw new Error('hourly trail: unreadable candle history');
    cached = { hour, rows: rows.map(r => ({ t: +r[0], o: +r[1], h: +r[2], l: +r[3], c: +r[4] })) };
    candleCache.set(symbol, cached);
  }
  const trail = hourlyTrail({ rows: cached.rows, entryPrice: seat.entryPrice,
    initialStop: seat.initialStop, priorStop, openedAt: seat.openedAt, now, side });
  const tick = +contract.priceTick || 10 ** -(+contract.pricePlace || 0);
  const trigger = +((S ? Math.ceil : Math.floor)((trail?.stop ?? priorStop) / tick) * tick).toFixed(+contract.pricePlace || 0);
  const mark = +pos.markPrice;
  if (!(mark > 0)) throw new Error('hourly trail: mark unavailable');
  // non-conforming wind-down (operator order 2026-11-08): seats the exec
  // flagged dust/denied/over-tier close at the FIRST fee-covered profit —
  // a mark-side move >= ~2.5x the RT taker toll is banked at market now,
  // never handed back to the trail. Seat-bound on cTime so a flag can't
  // jump to a fresh seat on the symbol.
  try {
    const ncf = readJson(path.join(root, 'state', 'nonconforming-seats.json'), true) || {};
    const fl = ncf[`${symbol}:${side}`];
    if (fl && +fl.cTime === +pos.cTime) {
      const coverPct = +(process.env.BW_FLAG_CLOSE_PCT || 0.3);
      const entry = +seat.entryPrice || +pos.openPriceAvg;
      const movePct = entry > 0 ? (S ? (entry - mark) / entry : (mark - entry) / entry) * 100 : 0;
      if (movePct >= coverPct) {
        await X.closePosition(symbol, side);
        return true;
      }
    }
  } catch {}
  if (S ? trigger <= mark : trigger >= mark) {
    // The closed-hour exit decision is already breached; never widen it to fit.
    await X.closePosition(symbol, side);
    return true;
  }
  const wholeStop = existing.find(p => p.planType === 'pos_loss' || +p.size >= +pos.total);
  if (!wholeStop || (S ? +wholeStop.triggerPrice > trigger : +wholeStop.triggerPrice < trigger)) {
    // Tighten-only ratchet: the new stop goes live BEFORE stale lower stops
    // are cancelled — no naked window — and priorStop feeding hourlyTrail
    // means an existing trigger can never sit above the computed stop.
    await X.planOrder(symbol, 'pos_loss', String(trigger), '0', side, pos.marginMode);
    const stale = existing.filter(p => S ? +p.triggerPrice > trigger + tick / 2 : +p.triggerPrice < trigger - tick / 2);
    const byType = new Map();
    for (const p of stale) {
      const id = p.orderId || p.id; if (!id) continue;
      const t = p.planType || 'pos_loss';
      byType.set(t, [...(byType.get(t) || []), String(id)]);
    }
    for (const [t, ids] of byType)
      await X.cancelPlanOrders(symbol, t, ids).catch(() => {});
  }
  return true;
}
